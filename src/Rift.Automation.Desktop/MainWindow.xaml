<Window x:Class="Rift.Automation.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="AutoFight - Physical RIFT / VMware (0.5.7)"
        Width="940" Height="740" MinWidth="720" MinHeight="560"
        Background="#101827" Foreground="#E6EDF7" Closed="OwnedTelemetryWindowClosed">
  <TabControl x:Name="ObserverTabs" SelectedIndex="0" Margin="12" Background="#101827" Foreground="#E6EDF7">
    <TabItem x:Name="PhysicalXyzTab" Header="Physical RIFT - Live XYZ">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <Border Background="#164B45" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock Text="PHYSICAL RIFT - LIVE NATIVE XYZ" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Foreground="#D2ECE6" Margin="0,5,0,0"
                         Text="AutoFight-owned read-only memory sampling on this Windows PC. No VMware, RR2 service, Lua addon, game input, focus changes, or automatic startup."/>
            </StackPanel>
          </Border>
          <TextBlock Text="1. Refresh and select an exact local RIFT process" FontSize="16" FontWeight="SemiBold" Margin="0,18,0,8"/>
          <Button x:Name="PhysicalXyzRefreshButton" Content="Refresh physical RIFT clients" Click="PhysicalXyzRefreshClicked"
                  HorizontalAlignment="Left"/>
          <TextBlock x:Name="PhysicalXyzInventorySummary" Text="Not checked. Refresh to discover physical RIFT processes."
                     TextWrapping="Wrap" Margin="0,10,0,9" Foreground="#A9BED7"/>
          <ListBox x:Name="PhysicalXyzClientPicker" Height="124" DisplayMemberPath="DisplayName"
                   SelectionChanged="PhysicalXyzClientSelectionChanged"
                   Background="#1B293E" Foreground="#E6EDF7" BorderBrush="#3A4C64"/>
          <TextBlock x:Name="PhysicalXyzPinnedText" Text="No process selected. A fresh PID/start-time identity check is required before Start."
                     TextWrapping="Wrap" Margin="0,9,0,0" FontFamily="Consolas"/>
          <Border Background="#1B293E" CornerRadius="8" Padding="16" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="2. Start / stop observation" FontSize="16" FontWeight="SemiBold"/>
              <TextBlock Text="One current-build native XYZ acquisition per second; each process read uses its own short read lease."
                         TextWrapping="Wrap" Foreground="#A9BED7" Margin="0,5,0,10"/>
              <StackPanel Orientation="Horizontal">
                <Button x:Name="PhysicalXyzStartButton" Content="Start read-only XYZ" Click="PhysicalXyzStartClicked" IsEnabled="False"/>
                <Button x:Name="PhysicalXyzStopButton" Content="Stop sampling" Click="PhysicalXyzStopClicked" IsEnabled="False" Margin="12,0,0,0"/>
              </StackPanel>
              <TextBlock x:Name="PhysicalXyzStatusText" Text="Stopped. No native observation requested."
                         Foreground="#F0CD7A" TextWrapping="Wrap" Margin="0,14,0,5"/>
              <TextBlock x:Name="PhysicalXyzCoordinatesText" Text="XYZ: unavailable" FontFamily="Consolas"
                         FontSize="24" FontWeight="SemiBold" Margin="0,10,0,0"/>
              <TextBlock x:Name="PhysicalXyzCandidateAgeText" Text="Candidate age: unavailable" Margin="0,8,0,0"/>
              <TextBlock x:Name="PhysicalXyzDifferenceText" Text="Position comparison: no baseline." Margin="0,8,0,0" TextWrapping="Wrap" Foreground="#B9D5CA"/>
              <TextBlock x:Name="PhysicalXyzCountsText" Text="Attempts: 0  |  Candidates: 0  |  Unavailable: 0  |  Identity faults: 0  |  Errors: 0"
                         TextWrapping="Wrap" Margin="0,8,0,0" Foreground="#A9BED7"/>
              <TextBlock x:Name="PhysicalXyzEvidenceText" Margin="0,14,0,0" TextWrapping="Wrap" Foreground="#F0CD7A"
                         Text="NATIVE CANDIDATE ONLY - passive freshness NOT QUALIFIED; 480-second qualification NOT PASSED; gameplay input authority NONE."/>
            </StackPanel>
          </Border>
          <TextBlock TextWrapping="Wrap" Foreground="#A9BED7" Margin="0,16,0,0"
                     Text="A candidate is one newly acquired, identity-pinned memory value. Repeated candidates alone do not prove the game updated its position. Wrong process, game-build mismatch, read failure, or stopping immediately removes displayed XYZ. Sampling starts only when you explicitly click Start."/>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem x:Name="VmTab" Header="VMware RIFT labs">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <Border Background="#163B63" CornerRadius="8" Padding="14">
            <StackPanel>
              <TextBlock Text="VMWARE CONTROLLERS" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Text="Live, authenticated controller status. A guest response confirms connection, not game telemetry freshness."/>
            </StackPanel>
          </Border>
          <TextBlock Margin="0,10,0,0" Text="Lab 1 controller config (existing private host.json)" />
          <TextBox x:Name="VmLab1Config" Text="C:\work\riftreader2\artifacts\control-fleet-live\lab1\host.json"
                   Background="#1B293E" Foreground="#E6EDF7" />
          <TextBlock Margin="0,8,0,0" Text="Lab 2 controller config (existing private host.json)" />
          <TextBox x:Name="VmLab2Config" Text="C:\work\riftreader2\artifacts\control-fleet-live\lab2\host.json"
                   Background="#1B293E" Foreground="#E6EDF7" />
          <Button x:Name="VmRefreshButton" Click="VmRefreshClicked" Content="Check both VM controllers"
                  Margin="0,12,0,0" HorizontalAlignment="Left" />
          <TextBlock x:Name="VmLab1Status" Text="Lab 1: not checked" Margin="0,9,0,0" TextWrapping="Wrap"/>
          <TextBlock x:Name="VmLab2Status" Text="Lab 2: not checked" Margin="0,5,0,0" TextWrapping="Wrap"/>
           <Border Background="#183C3C" CornerRadius="8" Padding="14" Margin="0,16,0,0">
             <StackPanel>
               <TextBlock Text="AUTOFIGHT STANDALONE TELEMETRY" FontSize="17" FontWeight="SemiBold"/>
               <TextBlock TextWrapping="Wrap" Foreground="#B9D5CA" Text="One reviewed VM lab. Read-only AutoFight receiver; no RR2 runtime, game input, or control authority."/>
               <TextBlock Text="Private host receiver config path (blank until reviewed)" Margin="0,8,0,0"/>
               <TextBox x:Name="OwnedTelemetryConfigPath" Background="#101827" Foreground="#E6EDF7"/>
               <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                 <Button x:Name="OwnedTelemetryStartButton" Content="Start receiver" Click="OwnedTelemetryStartClicked"/>
                 <Button x:Name="OwnedTelemetryStopButton" Content="Stop receiver" Click="OwnedTelemetryStopClicked" IsEnabled="False" Margin="12,0,0,0"/>
               </StackPanel>
               <TextBlock x:Name="OwnedTelemetryStatusText" Text="Stopped. No guest observation verified." Margin="0,10,0,0" TextWrapping="Wrap"/>
               <TextBlock x:Name="OwnedTelemetryPositionText" Text="XYZ: unavailable" FontSize="18" FontFamily="Consolas" Margin="0,6,0,0"/>
               <TextBlock x:Name="OwnedTelemetryAgeText" Text="Receipt age: unavailable" Margin="0,6,0,0"/>
               <TextBlock x:Name="OwnedTelemetrySequenceText" Text="Sequence: unavailable | Input authority: none" TextWrapping="Wrap" Margin="0,6,0,0"/>
             </StackPanel>
           </Border>
          <Border Background="#1B293E" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="PLAYER TELEMETRY" FontWeight="SemiBold"/>
              <TextBlock TextWrapping="Wrap" Foreground="#F0CD7A" Margin="0,6,0,8"
                         Text="Reads existing RR2 receiver files with pinned game/reader identities. Old source pins or expired readers will show unavailable until refreshed. No game input is sent."/>
              <TextBlock Text="Lab 1 reviewed source pin" Margin="0,7,0,0"/>
              <TextBox x:Name="VmLab1Pin" Text="C:\work\riftreader2\artifacts\two-lab-resume-20261030\fastcandidate-lab1-source-pin-02.json"
                       Background="#101827" Foreground="#E6EDF7"/>
              <TextBlock Text="Lab 2 reviewed source pin" Margin="0,7,0,0"/>
              <TextBox x:Name="VmLab2Pin" Text="C:\work\riftreader2\artifacts\two-lab-resume-20261030\phase2-lab2-source-pin-01.json"
                       Background="#101827" Foreground="#E6EDF7"/>
              <Button x:Name="VmTelemetryButton" Content="Read both VM positions" Click="VmTelemetryClicked"
                      Margin="0,12,0,0" HorizontalAlignment="Left"/>
              <Button x:Name="VmPreflightButton" Content="Check both lab bindings (read-only)"
                       Click="VmBoundPreflightClicked" Margin="0,9,0,0" HorizontalAlignment="Left"/>
               <TextBlock x:Name="VmLab1Binding" Text="Lab 1 binding: not checked"
                          Margin="0,8,0,0" TextWrapping="Wrap"/>
               <TextBlock x:Name="VmLab2Binding" Text="Lab 2 binding: not checked"
                          Margin="0,5,0,0" TextWrapping="Wrap"/>
               <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                <Button x:Name="VmWatchStartButton" Content="Start live position watch"
                        Click="VmWatchStartClicked"/>
                <ComboBox x:Name="VmWatchDuration" SelectedIndex="1" Width="96" Margin="12,0,0,0">
                  <ComboBoxItem Content="15 seconds" Tag="15"/>
                  <ComboBoxItem Content="30 seconds" Tag="30"/>
                  <ComboBoxItem Content="60 seconds" Tag="60"/>
                </ComboBox>
                <Button x:Name="VmWatchStopButton" Content="Stop watch" Margin="12,0,0,0"
                        Click="VmWatchStopClicked" IsEnabled="False"/>
              </StackPanel>
              <TextBlock x:Name="VmWatchSummary" Margin="0,9,0,0" TextWrapping="Wrap"
                         Text="Watch not started. Polls every 500 ms, read-only. No automation authority."/>
              <TextBlock x:Name="VmWatchLab1" Text="Lab 1 watch: not started" Margin="0,6,0,0"
                         TextWrapping="Wrap"/>
              <TextBlock x:Name="VmWatchLab2" Text="Lab 2 watch: not started" Margin="0,6,0,0"
                         TextWrapping="Wrap"/>
              <Border BorderBrush="#3A4C64" BorderThickness="1" CornerRadius="6"
                      Padding="12" Margin="0,14,0,0">
                <StackPanel>
                  <TextBlock Text="8-MINUTE TELEMETRY EVIDENCE" FontWeight="SemiBold"/>
                  <TextBlock Margin="0,5,0,8" Foreground="#F0CD7A" TextWrapping="Wrap"
                             Text="Explicit one-lab, 480-second read-only check. Every telemetry progress gap must be under 4.5 seconds. No input, controller contact, movement qualification or action permission."/>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="Lab:" VerticalAlignment="Center"/>
                    <ComboBox x:Name="VmQualifyLab" Width="84" SelectedIndex="0" Margin="8,0,12,0">
                      <ComboBoxItem Content="lab1"/><ComboBoxItem Content="lab2"/>
                    </ComboBox>
                    <Button x:Name="VmQualifyStartButton" Content="Check 8-minute feedback"
                            Click="VmQualifyStartClicked"/>
                    <Button x:Name="VmQualifyStopButton" Content="Stop check" Margin="12,0,0,0"
                            Click="VmQualifyStopClicked" IsEnabled="False"/>
                     <Button x:Name="VmQualifySaveButton" Content="Save redacted report" Margin="12,0,0,0"
                             Click="VmQualifySaveClicked" IsEnabled="False"/>
                  </StackPanel>
                  <TextBlock x:Name="VmQualifyProgress" Margin="0,9,0,0" TextWrapping="Wrap"
                             Text="Not started. Uses the selected lab's reviewed source pin."/>
                  <TextBlock x:Name="VmQualifySummary" Margin="0,6,0,0" TextWrapping="Wrap"
                             Text="No evidence collected. A completed check never enables input."/>
                   <TextBlock x:Name="VmQualifySaveStatus" Margin="0,6,0,0" TextWrapping="Wrap"
                              Text="No finished result to save."/>
                </StackPanel>
              </Border>
               <TextBlock x:Name="VmLab1Telemetry" Text="Lab 1 telemetry: not checked" Margin="0,8,0,0" TextWrapping="Wrap"/>
              <TextBlock x:Name="VmLab2Telemetry" Text="Lab 2 telemetry: not checked" Margin="0,5,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
          <Border Background="#1B293E" CornerRadius="8" Padding="14" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="SEND ONE SUPERVISED INPUT" FontWeight="SemiBold" />
              <TextBlock TextWrapping="Wrap" Foreground="#F0CD7A" Margin="0,6,0,8"
                         Text="Requires the control owner's existing lease and short-lived arm files. One explicit key pulse; no automatic arming or repeat. HTTP acknowledgment does NOT prove movement."/>
              <StackPanel Orientation="Horizontal">
                <TextBlock Text="Lab:" VerticalAlignment="Center" />
                <ComboBox x:Name="VmActionLab" SelectedIndex="0" Width="80" Margin="8,0,12,0">
                  <ComboBoxItem Content="lab1" /><ComboBoxItem Content="lab2" />
                </ComboBox>
                <TextBlock Text="Key:" VerticalAlignment="Center" />
                <ComboBox x:Name="VmActionKey" SelectedIndex="0" Width="72" Margin="8,0,12,0">
                  <ComboBoxItem Content="w"/><ComboBoxItem Content="a"/><ComboBoxItem Content="s"/>
                  <ComboBoxItem Content="d"/><ComboBoxItem Content="q"/><ComboBoxItem Content="e"/>
                </ComboBox>
                <TextBlock Text="Hold ms:" VerticalAlignment="Center" />
                <TextBox x:Name="VmActionHold" Text="50" Width="48" Margin="8,0,0,0" />
              </StackPanel>
              <TextBlock Text="Private lease file" Margin="0,9,0,0" />
              <TextBox x:Name="VmLeaseFile" Background="#101827" Foreground="#E6EDF7" />
              <TextBlock Text="Current reviewed arm file" Margin="0,9,0,0" />
              <TextBox x:Name="VmArmFile" Background="#101827" Foreground="#E6EDF7" />
              <Button x:Name="VmPulseButton" Click="VmPulseClicked" Content="Send one authorized pulse"
                      Margin="0,12,0,0" HorizontalAlignment="Left" />
              <TextBlock x:Name="VmActionResult" Text="No input requested." Margin="0,9,0,0" TextWrapping="Wrap"/>
            </StackPanel>
          </Border>
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem x:Name="ClientsTab" Header="RIFT clients">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <Border Background="#163B63" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock Text="RIFT CLIENTS" FontSize="20" FontWeight="SemiBold" />
              <TextBlock Margin="0,6,0,0" Text="Read-only Windows process discovery. Select a client to inspect its details; this does not connect game data or send input." />
            </StackPanel>
          </Border>
          <WrapPanel Margin="0,18,0,0">
            <Button x:Name="RefreshClientsButton" Content="Refresh RIFT clients" Click="RefreshClientsClicked" />
          </WrapPanel>
          <TextBlock x:Name="ClientSummaryText" Margin="0,12,0,12" Text="Not scanned. Click Refresh RIFT clients." />
          <ListBox x:Name="ClientsList" Height="160" DisplayMemberPath="DisplayName"
                   SelectionChanged="ClientSelectionChanged" Background="#1B293E" Foreground="#E6EDF7"
                   BorderBrush="#3A4C64" ScrollViewer.HorizontalScrollBarVisibility="Auto" />
          <Border Background="#1B293E" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="SELECTED CLIENT" FontWeight="SemiBold" Foreground="#A9BED7" />
              <TextBlock x:Name="ClientDetailsText" Margin="0,8,0,0" Text="No client selected." />
            </StackPanel>
          </Border>
          <TextBlock Margin="0,16,0,0" Foreground="#F0CD7A"
                     Text="This tab only inspects local rift_x64 process metadata. For current-build read-only XYZ candidates, use the Physical RIFT - Live XYZ tab. Native candidates do not prove movement or enable control." />
          <TextBlock Margin="0,10,0,0" Foreground="#A9BED7"
                     Text="The list is a point-in-time snapshot. Refresh after starting or closing RIFT. No automatic polling, game focus changes, or VMware access." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem x:Name="UnitTab" Header="Manual unit snapshot">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <Border Background="#163B63" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock Text="MANUAL COLLECTOR SNAPSHOT" FontSize="20" FontWeight="SemiBold"/>
              <TextBlock Margin="0,6,0,0" TextWrapping="Wrap"
                         Text="Open a saved RAC-TSV/1 player or target export. The original collection time is unavailable. This is not live telemetry and cannot control the game."/>
            </StackPanel>
          </Border>
          <Button x:Name="OpenUnitButton" Content="Open unit export (.tsv)"
                  Margin="0,18,0,0" HorizontalAlignment="Left" Click="OpenUnitClicked" />
          <TextBlock x:Name="UnitSummaryText" Margin="0,16,0,0" TextWrapping="Wrap"
                     Text="No manual snapshot loaded." Foreground="#F0CD7A" />
          <Border Background="#1B293E" CornerRadius="8" Padding="16" Margin="0,14,0,0">
            <TextBlock x:Name="UnitFieldsText" FontFamily="Consolas"
                       TextWrapping="Wrap" Text="No imported fields." />
          </Border>
          <TextBlock TextWrapping="Wrap" Foreground="#A9BED7" Margin="0,14,0,0"
                     Text="Coordinates can be partial or missing. Saved snapshots have no reliable sample age, and remain separate from the replay simulation and client-process inventory." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
    <TabItem x:Name="ReplayTab" Header="Offline replay">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="20">
          <Border Background="#163B63" CornerRadius="8" Padding="16">
            <StackPanel>
              <TextBlock x:Name="ModeBanner" Text="SYNTHETIC REPLAY - NO GAME DATA"
                         FontSize="20" FontWeight="SemiBold" />
              <TextBlock Margin="0,6,0,0"
                         Text="Values and time come from a bounded test scenario, not the client selected in the other tab." />
            </StackPanel>
          </Border>
          <TextBlock x:Name="ScenarioText" Margin="0,18,0,6" FontSize="18" FontWeight="SemiBold" />
          <TextBlock x:Name="ProgressText" Foreground="#A9BED7" />
          <TextBlock x:Name="IdentityText" Margin="0,6,0,0" Foreground="#A9BED7" />
          <Border Background="#1B293E" CornerRadius="8" Padding="16" Margin="0,18,0,0">
            <StackPanel>
              <TextBlock Text="PLAYER POSITION" FontWeight="SemiBold" Foreground="#A9BED7" />
              <TextBlock x:Name="StatusText" FontSize="19" FontWeight="SemiBold" Margin="0,8,0,0" />
              <TextBlock x:Name="PositionText" FontSize="25" FontFamily="Consolas" Margin="0,8,0,0" />
              <TextBlock x:Name="LastKnownText" Foreground="#A9BED7" Margin="0,6,0,0" />
              <TextBlock x:Name="AgeText" Margin="0,10,0,0" />
              <TextBlock x:Name="SourceText" Margin="0,5,0,0" />
              <TextBlock x:Name="ReasonText" Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <Border BorderBrush="#3A4C64" BorderThickness="1" CornerRadius="8" Padding="16" Margin="0,16,0,0">
            <StackPanel>
              <TextBlock Text="CAPABILITIES" FontWeight="SemiBold" Foreground="#A9BED7" />
              <TextBlock x:Name="ObservationCapabilityText" Margin="0,7,0,0" />
              <TextBlock Text="Combat / targeting / movement: not implemented." Margin="0,5,0,0" />
              <TextBlock Text="Native player/camera data and 3D navigation: not connected." Margin="0,5,0,0" />
            </StackPanel>
          </Border>
          <WrapPanel Margin="0,18,0,0">
            <Button x:Name="NextButton" Content="Next replay step" Click="NextClicked" />
            <Button Content="Reset replay" Click="ResetClicked" />
            <Button Content="Load demo" Click="DemoClicked" />
            <Button Content="Open replay file" Click="OpenClicked" />
          </WrapPanel>
          <TextBlock x:Name="ResultText" Margin="0,12,0,0" Foreground="#F0CD7A" />
          <TextBlock Margin="0,14,0,0" Foreground="#A9BED7"
                     Text="Replay time advances only with steps. The 1,000 ms freshness limits are synthetic test settings, not live-game limits." />
        </StackPanel>
      </ScrollViewer>
    </TabItem>
  </TabControl>
</Window>
